# Copy to secrets.env (gitignored, chmod 600). Loaded automatically by scripts/lib.sh, so every factory script
# sees these; workers use them only through scripts (never print or commit them). Check with scripts/secrets-check.sh.

# Jira/Confluence REST (attachments cannot go through the Atlassian MCP). Token: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_DOMAIN=your-site            # https://<this>.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# CircleCI personal API token: https://app.circleci.com/settings/user/tokens
CIRCLECI_TOKEN=

# Not here: GitHub (gh auth login), org SonarQube (sonar auth login, OS keychain), local SonarQube (sonar/local.env, generated).
